# ============================================================
# ChainNetra Environment Configuration Template
# ============================================================

# Platform Mode: DEMO (deterministic offline dataset) or LIVE (public blockchain APIs & strict auth)
CHAINNETRA_MODE=DEMO

# Security Secrets (Required in LIVE mode. Generate using `openssl rand -hex 32`)
SECRET_KEY=change-me
WEBHOOK_SECRET=change-me
AUDIT_HMAC_KEY=change-me

# JWT & Session Lifecycles
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (SQLite WAL mode by default; can swap to PostgreSQL in production)
DATABASE_URL=sqlite:///./chainnetra.db

# Live Blockchain Provider API Keys & Configs (Optional in DEMO mode)
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
BLOCKSTREAM_API_URL=https://blockstream.info/api
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
ADAPTER_MAX_PAGES=5
ADAPTER_TIMEOUT=10.0

# Currency Rates & Static Pegs
USD_INR=83.50

# Audit Checkpoint Interval (Entries)
AUDIT_CHECKPOINT_INTERVAL=50
