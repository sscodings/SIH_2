# ============================================================
# ChainNetra Environment Configuration Template
# ============================================================

# Platform Mode: DEMO (deterministic offline dataset) or LIVE (public blockchain APIs)
CHAINNETRA_MODE=DEMO

# Security & Session Authentication
SECRET_KEY=netra-super-secret-jwt-forensic-key-2026-sih-prototype
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite WAL mode by default; can swap to PostgreSQL in production)
DATABASE_URL=sqlite:///./chainnetra.db

# Live Blockchain Provider API Keys (Optional - Free tiers work)
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
BLOCKSTREAM_API_URL=https://blockstream.info/api

# Currency Rates & Static Pegs
USD_INR_RATE=83.50

# Automated Monitoring
WATCHLIST_MONITOR_INTERVAL_SECONDS=30
